# Copy to .env and adjust as needed. Defaults work out-of-the-box for local dev.
# Docker Compose reads this file, and so do the local `make` targets (api, train, ...).

# --- Ports ---
# Every service listens on this machine only. 0.0.0.0 opens them to your network;
# none of them asks for a password, so only do that on a network you trust.
# BIND_ADDRESS=127.0.0.1

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP=localhost:9092
TRADES_TOPIC=crypto.trades
BARS_TOPIC=crypto.bars_10s

# --- Symbols to stream (Binance lowercase, comma-separated) ---
SYMBOLS=btcusdt,ethusdt,solusdt
# Binance's market-data-only WebSocket. If it is ever unreachable, the main endpoint
# (wss://stream.binance.com:9443/stream?streams=) sends the same data outside the US.
BINANCE_WS_BASE=wss://data-stream.binance.vision/stream?streams=

# --- SeaweedFS (S3-compatible data lake) ---
LAKE_ACCESS_KEY=lakeadmin
LAKE_SECRET_KEY=lakeadmin
LAKE_BUCKET=crypto-lake
# Only for running Dagster on your Mac against the Docker lake; `make up` sets its own.
# LAKE_URI=s3://crypto-lake/features/ohlcv_10s
# LAKE_ENDPOINT=http://localhost:8333
# Raw trades older than this are deleted; the 10s bars are kept.
RAW_RETENTION_DAYS=7

# --- Dagster schedule ---
# How often Dagster refreshes the warehouse and retrains (cron). Every 15 minutes by
# default; hourly is much lighter on a laptop. Keep the quotes: `make` reads this file
# with the shell, which would otherwise expand the asterisks.
# REFRESH_CRON="0 * * * *"

# --- MLflow ---
# Docker sets its own. Uncomment to log local `make train` runs to the Docker MLflow
# server (needs `make up`); left unset, they go to ./mlruns.
# MLFLOW_TRACKING_URI=http://localhost:5001

# --- LLM market-summary agent ---
# Leave OPENAI_API_KEY blank to use the built-in offline template summariser (no cost).
# Or set it to use OpenAI, or point OPENAI_BASE_URL at a local Ollama server.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
